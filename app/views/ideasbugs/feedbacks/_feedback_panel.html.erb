<section class="detail-panel">
  <div class="panel-head">
    <h1>
      <span class="badge kind-<%= feedback.kind.to_s.parameterize %>">
        <%= t("ideasbugs.kinds.#{feedback.kind}", default: feedback.kind.humanize) %>
      </span>
      <span class="case-id">#<%= feedback.id %></span>
    </h1>

    <%# The shared status switch, carrying the status the heading badge used to
        state: the current one is lit and inert, every other one is a submit
        that files the report under it. One form, no JS. A duplicate has no
        lifecycle of its own: it follows its original. %>
    <% unless feedback.duplicate? %>
    <%= form_with url: feedback_path(feedback), method: :patch, class: 'status-switch' do %>
      <% Ideasbugs::Feedback::STATUSES.each do |status| %>
        <% label = t("ideasbugs.statuses.#{status}", default: status.humanize) %>
        <% if status == feedback.status %>
          <button type="button" class="status-<%= status %> current" aria-current="true"><%= label %></button>
        <% else %>
          <button name="feedback[status]" value="<%= status %>" class="status-<%= status %>"
                  aria-label="<%= t("ideasbugs.dashboard.move_to_#{status}", default: "Mark #{status.humanize.downcase}") %>">
            <%= label %>
          </button>
        <% end %>
      <% end %>
    <% end %>
    <% end %>
  </div>

  <div class="detail-scroll">
    <% if flash[:alert] %>
      <p class="flash alert" role="alert"><%= flash[:alert] %></p>
    <% end %>

    <% if feedback.duplicate? && (original = feedback.duplicate_of) %>
      <div class="card pad duplicate-of">
        <p>
          <%= t('ideasbugs.dashboard.duplicate_of', default: 'Duplicate of') %>
          <%= link_to "##{original.id}", feedbacks_path(status: original.status, feedback_id: original.id) %>
          <span class="badge status-<%= original.status %>">
            <%= t("ideasbugs.statuses.#{original.status}", default: original.status.humanize) %>
          </span>
        </p>
        <p class="muted"><%= truncate(original.message, length: 160) %></p>
        <%= button_to t('ideasbugs.dashboard.not_duplicate', default: 'Not a duplicate'),
                      feedback_duplicate_path(feedback), method: :delete, class: 'small' %>
      </div>
    <% end %>
    <div class="card pad">
      <dl>
        <% if feedback.section.present? %>
          <dt><%= t('ideasbugs.section', default: 'Section') %></dt>
          <dd><%= feedback.section %></dd>
        <% end %>
        <% if (author = feedback.author_reference) %>
          <dt><%= t('ideasbugs.dashboard.from', default: 'From') %></dt>
          <dd><%= author %></dd>
        <% end %>
        <% if feedback.page_url.present? %>
          <dt><%= t('ideasbugs.dashboard.page', default: 'Page') %></dt>
          <dd><%= link_to feedback.page_url, feedback.page_url, target: '_blank', rel: 'noopener' %></dd>
        <% end %>
        <% if feedback.user_agent.present? %>
          <dt><%= t('ideasbugs.dashboard.browser', default: 'Browser') %></dt>
          <dd class="muted"><%= feedback.user_agent %></dd>
        <% end %>
        <dt><%= t('ideasbugs.dashboard.filed', default: 'Filed') %></dt>
        <dd><%= feedback.created_at %></dd>
      </dl>
    </div>

    <div class="card pad">
      <p class="message"><%= feedback.message %></p>

      <% if feedback.screenshots? %>
        <div class="shots">
          <% feedback.screenshots.each do |screenshot| %>
            <%= link_to feedback_screenshot_path(feedback, screenshot.id), target: '_blank', rel: 'noopener' do %>
              <%= image_tag feedback_screenshot_path(feedback, screenshot.id), alt: screenshot.filename %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% duplicates = Ideasbugs::Feedback.tracks_duplicates? ? feedback.duplicates.newest_first.to_a : [] %>
    <% if duplicates.any? %>
      <section class="card duplicates" aria-labelledby="duplicates-<%= feedback.id %>">
        <h2 id="duplicates-<%= feedback.id %>">
          <%= t('ideasbugs.dashboard.duplicates', default: 'Duplicates') %> <span class="count"><%= duplicates.size %></span>
        </h2>
        <% duplicates.each do |duplicate| %>
          <%= link_to feedbacks_path(status: feedback.status, feedback_id: duplicate.id), class: 'record-row' do %>
            <span class="record-main">
              <span class="record-copy"><%= truncate(duplicate.message, length: 120) %></span>
              <span class="muted record-meta">
                <span>#<%= duplicate.id %></span>
                <% if duplicate.author_label.present? %>
                  <span><%= duplicate.author_label %></span>
                <% end %>
              </span>
            </span>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <%# Status lives in the switch in the heading; only what a switch cannot say
        is left here. %>
    <div class="actions">
      <% if Ideasbugs::Feedback.tracks_duplicates? && !feedback.duplicate? %>
        <%= form_with url: feedback_duplicate_path(feedback), method: :post, class: 'mark-duplicate' do %>
          <label for="original_id_<%= feedback.id %>"><%= t('ideasbugs.dashboard.mark_duplicate', default: 'Mark as duplicate of #') %></label>
          <input type="text" name="original_id" id="original_id_<%= feedback.id %>" required autocomplete="off">
          <button><%= t('ideasbugs.dashboard.mark_duplicate_submit', default: 'Mark duplicate') %></button>
        <% end %>
      <% end %>
      <%= button_to t('ideasbugs.dashboard.delete', default: 'Delete'),
                    feedback_path(feedback),
                    method: :delete, class: 'danger',
                    form: { onsubmit: "return confirm('#{t('ideasbugs.dashboard.delete_confirm', default: 'Delete this feedback?')}')" } %>
    </div>
  </div>
</section>
